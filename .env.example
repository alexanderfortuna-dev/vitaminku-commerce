# Salin ke .env untuk lokal; di produksi isi lewat dashboard Vercel. JANGAN commit nilai asli.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Aktivasi akun owner (sekali pakai)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_SECRET=
# Opsional: pembayaran & pengiriman
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
BITESHIP_API_KEY=
SHIPPING_ORIGIN_POSTAL_CODE=
# Asisten Vita: isi SALAH SATU. ANTHROPIC_API_KEY (Claude, disarankan) atau AI_API_KEY (+AI_BASE_URL) untuk penyedia kompatibel OpenAI.
ANTHROPIC_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# URL toko (tautan produk di alat MCP)
PUBLIC_SITE_URL=
# Alamat publik situs (tanpa garis miring akhir), untuk sitemap.xml, robots.txt, dan url JSON-LD. Opsional.
SITE_URL=
VITE_SITE_URL=
