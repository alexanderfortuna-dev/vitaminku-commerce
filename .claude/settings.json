{
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob", "Edit", "Write",
      "Bash(bun install*)", "Bash(bun run *)", "Bash(npx tsc *)", "Bash(npx vitest *)",
      "Bash(bash scripts/verify.sh)", "Bash(bash test/db/run.sh)",
      "Bash(git status*)", "Bash(git diff *)", "Bash(git log *)", "Bash(git switch *)", "Bash(git checkout *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git fetch *)",
      "Bash(git push origin claude/*)", "Bash(git push -u origin claude/*)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.production)",
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(git push origin main*)", "Bash(git push origin develop*)", "Bash(git push origin feat/launch-ready-v3*)",
      "Bash(vercel *)", "Bash(npx vercel*)", "Bash(psql *)", "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|Read|Edit|Write",
        "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify_on_stop.py\"", "timeout": 900 } ] }
    ]
  }
}
